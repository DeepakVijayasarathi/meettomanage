# Loaded by `npm run build:uat` (`vite build --mode uat`) -- the UAT deployment's own build,
# separate from `.env.production` (the real prod build `npm run build` still uses). Same rules
# as `.env.production`: must be the public URL browsers can reach, HTTPS to match the page.
VITE_API_BASE_URL=https://uatapi.thereadernest.in

# Jitsi Meet deployment that hosts UAT's live classrooms. Assumed to be the same self-hosted
# Jitsi cluster production uses (see docs/JITSI_ARCHITECTURE.md) rather than a separate UAT-only
# one -- correct this if UAT actually has its own Jitsi deployment.
VITE_JITSI_DOMAIN=thereadernest.co.in
