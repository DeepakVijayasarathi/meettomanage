{
  "name": "meettomanage-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Meet to Manage with a Claude CLI powered AI assistant",
  "main": "main.cjs",
  "scripts": {
    "start": "node launch.cjs",
    "dev": "node launch.cjs --dev",
    "demo:readernest": "node launch.cjs --demo-api=https://api.thereadernest.in",
    "test": "node demo-guard.test.cjs",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.meettomanage.desktop",
    "productName": "Meet to Manage",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "main.cjs",
      "demo-guard.cjs",
      "preload-site.cjs",
      "rich-output.md",
      "mcp/**",
      "build/icon.png",
      {
        "from": "../dist",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MeetToManage-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MeetToManage-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "author": "Meet to Manage"
}