# Loaded by `npm run build` (production mode) — this is what the Docker image ships.
# `.env.development` is only used by the local dev server (`npm run dev`).
#
# Must be the public URL browsers can reach the API on. If the frontend is served
# over HTTPS this must be HTTPS too (browsers block mixed content) — use the API's
# domain, not the raw IP: e.g. http://93.127.194.128:1002 only works from an
# http:// page.
VITE_API_BASE_URL=https://api.thereadernest.in

# Jitsi Meet deployment that hosts the live classrooms (see docs/JITSI_ARCHITECTURE.md).
# Bare host only, no scheme — JitsiLive.tsx builds https://$VITE_JITSI_DOMAIN/external_api.js itself.
VITE_JITSI_DOMAIN=thereadernest.co.in
