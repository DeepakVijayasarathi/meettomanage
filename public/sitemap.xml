<?xml version="1.0" encoding="UTF-8"?>
<!-- Sitemap index: fixed site pages, plus every published blog post. sitemap-blog.xml is
     generated live by the API (proxied by nginx.conf), so a scheduled post is listed the
     moment it goes live without a redeploy. -->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://meettomanage.cloud/sitemap-pages.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://meettomanage.cloud/sitemap-blog.xml</loc>
  </sitemap>
</sitemapindex>
