  // horizontal center, `gap` px above its top edge. boxWidth is the *measured* width
  // from measureCalloutWidth(), so the clamp below is exact, not a guess — only a
  // small fixed margin, not an inflated safety pad. When a target sits close to the
  // 1920px edge the box's center gets nudged inward just enough to stay fully on
  // screen, while the pointer stays pinned to the true target center via `pointerShift`.
  function callout(centerX, targetTopY, text, boxWidth, gap = 20) {
    const viewportW = 1920;
    const margin = 20;
    const halfWidth = boxWidth / 2;
    const boxCenterX = Math.min(Math.max(centerX, halfWidth + margin), viewportW - halfWidth - margin);
    const pointerShift = Math.max(Math.min(centerX - boxCenterX, halfWidth - 14), -(halfWidth - 14));
