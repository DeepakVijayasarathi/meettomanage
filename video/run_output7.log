async page => {
  const BRAND = "#F97316";

  // Measures the tooltip's *actual* rendered width (same font/padding as the real
  // callout) instead of estimating from character count — the earlier length-based
  // estimate was off enough (and in the wrong direction depending on the string) to
  // either clip the box off-screen or, once over-corrected with a flat safety margin,
  // shove it well clear of the target it's supposed to be pointing at.
  async function measureCalloutWidth(text) {
    return page.evaluate(t => {
      const d = document.createElement("div");
      d.style.cssText =
        "position:fixed; left:-9999px; top:-9999px; padding:10px 18px; " +
        "font:700 15px/1.3 'Segoe UI', system-ui, sans-serif; white-space:nowrap;";
      d.textContent = t;
      document.body.appendChild(d);
      const w = d.getBoundingClientRect().width;
      d.remove();
      return w;
    }, text);
