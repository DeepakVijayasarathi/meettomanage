await (// Full continuous recording for the Meet to Manage demo video.
// - No marketing/landing-page footage: hook goes straight into the product.
// - Chapter beats use a custom animated overlay (fade-up text + slow Ken Burns
//   background pan) instead of the default showChapter template, for livelier motion.
// - Beat durations are paced from voiceover/manifest.json (actual TTS length); the
//   exact real screen-time per beat is measured via the returned beatLog and then
//   padded/trimmed frame-accurately in assemble.py — the waits below just need to be
//   in the right ballpark, not frame-perfect.
async page => {
  const BRAND = "#F97316";

  // (centerX, targetTopY) — anchors the tooltip's pointer directly above the target's
  // horizontal center, `gap` px above its top edge, instead of the old top-left corner
  // placement (which let long labels drift away from whatever they were pointing at).
  // centerX is clamped so the box (width estimated from the label) never runs past the
  // 1920px viewport — several targets sit close to the right edge — while the pointer
  // stays pinned to the true target center via `pointerShift`, so the arrow still lands
  // on the target even when the box itself has been nudged to stay on-screen.
  function callout(centerX, targetTopY, text, gap = 16) {
    const viewportW = 1920;
    const estHalfWidth = (text.length * 8.6) / 2 + 20;
    const boxCenterX = Math.min(Math.max(centerX, estHalfWidth + 16), viewportW - estHalfWidth - 16);
    const pointerShift = Math.max(Math.min(centerX - boxCenterX, estHalfWidth - 14), -(estHalfWidth - 14));
    return `
      <div style="position:absolute; left:${boxCenterX}px; top:${targetTopY - gap}px;
        transform: translate(-50%, -100%); display:flex; flex-direction:column; align-items:center;
        animation: mtmCalloutIn .32s cubic-bezier(.16,1,.3,1) both;">
        <style>
          @keyframes mtmCalloutIn {
            from { opacity: 0; transform: translateY(8px) scale(.9); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
          }
        </style>
        <div style="padding:10px 18px; border-radius:10px;
          background: linear-gradient(135deg, ${BRAND}, #ea580c);
          color:#fff; font:700 15px/1.3 'Segoe UI', system-ui, sans-serif; white-space:nowrap;
          box-shadow: 0 12px 26px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.25);">
          ${text}
        </div>
        <div style="width:0; height:0; border-left:7px solid transparent; border-right:7px solid transparent;
          border-top:8px solid #ea580c; margin-top:-1px; transform: translateX(${pointerShift}px);
          filter: drop-shadow(0 3px 3px rgba(0,0,0,.25));"></div>
      </div>`;
  }

  function animatedCard(title, subtitle, opts = {}) {
    const logo = opts.logo
      ? `<div style="width:84px; height:84px; border-radius:22px; margin-bottom:24px;
          display:flex; align-items:center; justify-content:center;
          background: linear-gradient(160deg, #fff7ed, #ffe4c7);
          box-shadow: 0 10px 24px rgba(249,115,22,.22), inset 0 1px 0 rgba(255,255,255,.9);
          animation: mtmPop .7s cubic-bezier(.34,1.56,.64,1) .15s both, mtmLogoPulse 2.6s ease-in-out 1.3s infinite;">
          <img src="/logo-icon.png" style="width:50px;height:50px;object-fit:contain;" />
        </div>`
      : "";
    const cta = opts.ctaLabel
      ? `<div style="margin-top:28px; padding:14px 34px; border-radius:999px;
          background: linear-gradient(135deg, ${BRAND}, #ea580c);
