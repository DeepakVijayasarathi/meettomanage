          box-shadow: 0 14px 30px rgba(249,115,22,.35), inset 0 1px 0 rgba(255,255,255,.3);
          animation: mtmFadeUpDelay .7s cubic-bezier(.16,1,.3,1) .5s both, mtmCtaPulse 2.2s ease-in-out 1.5s infinite;">
          ${opts.ctaLabel} →
        </div>`
      : "";
    return `
      <div style="position:absolute; inset:0; overflow:hidden; background:#0a0e1a;">
        <style>
          @keyframes mtmKenBurns {
            from { transform: scale(1.05) translate(0%, 0%); }
            to   { transform: scale(1.14) translate(-1%, -1%); }
          }
          @keyframes mtmDrift1 {
            from { transform: translate(-6%, -4%) scale(1); }
            to   { transform: translate(4%, 6%) scale(1.15); }
          }
          @keyframes mtmDrift2 {
            from { transform: translate(5%, 4%) scale(1.1); }
            to   { transform: translate(-4%, -6%) scale(1); }
          }
          @keyframes mtmFadeUp {
            from { opacity: 0; transform: translateY(26px); }
            to   { opacity: 1; transform: translateY(0); }
          }
          @keyframes mtmFadeUpDelay {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
          }
          @keyframes mtmPop {
            0%   { opacity: 0; transform: scale(.5); }
            65%  { opacity: 1; transform: scale(1.15); }
            100% { opacity: 1; transform: scale(1); }
          }
          @keyframes mtmCardIn {
            from { opacity: 0; transform: translateY(16px) scale(.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
          }
          @keyframes mtmUnderline {
            from { transform: scaleX(0); }
            to   { transform: scaleX(1); }
          }
          @keyframes mtmLogoPulse {
            0%, 100% { filter: drop-shadow(0 0 0 rgba(249,115,22,0)); }
            50%      { filter: drop-shadow(0 0 22px rgba(249,115,22,.75)); }
          }
          @keyframes mtmCtaPulse {
            0%, 100% { box-shadow: 0 14px 30px rgba(249,115,22,.35), 0 0 0 0 rgba(249,115,22,.5); }
            50%      { box-shadow: 0 14px 30px rgba(249,115,22,.35), 0 0 0 14px rgba(249,115,22,0); }
          }
        </style>

        <!-- Base: deep navy, slow Ken Burns breathing -->
        <div style="position:absolute; inset:-8%;
          background: linear-gradient(160deg, #0a0e1a 0%, #131b2e 55%, #0a0e1a 100%);
          animation: mtmKenBurns 10s ease-in-out infinite alternate;"></div>

        <!-- Two soft drifting colour blobs — mesh-gradient look, not a flat radial blend -->
        <div style="position:absolute; width:65%; height:65%; left:-14%; top:-16%; border-radius:50%;
          background: radial-gradient(circle, ${BRAND}66 0%, transparent 68%);
          filter: blur(70px); animation: mtmDrift1 13s ease-in-out infinite alternate;"></div>
        <div style="position:absolute; width:60%; height:60%; right:-16%; bottom:-18%; border-radius:50%;
          background: radial-gradient(circle, #3454c466 0%, transparent 68%);
          filter: blur(80px); animation: mtmDrift2 15s ease-in-out infinite alternate;"></div>

        <!-- Fine grain for a tactile, non-flat finish -->
        <div style="position:absolute; inset:0; opacity:.05;
          background-image: radial-gradient(rgba(255,255,255,.9) 1px, transparent 1px);
          background-size: 22px 22px;"></div>

        <!-- Vignette to pull focus to the center card -->
        <div style="position:absolute; inset:0;
          background: radial-gradient(ellipse at 50% 50%, transparent 35%, rgba(0,0,0,.5) 100%);"></div>

        <!-- White content card, floating over the dark ambient background —
             layered shadow (tight contact shadow + broad soft one) for real elevation,
             a brand gradient strip along the top edge instead of a floating underline. -->
        <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; padding:0 80px;">
          <div style="max-width:1160px; border-radius:28px; overflow:hidden;
            background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
            box-shadow: 0 1px 2px rgba(15,23,42,.06), 0 18px 40px rgba(0,0,0,.28), 0 60px 120px rgba(0,0,0,.4);
            animation: mtmCardIn .6s cubic-bezier(.16,1,.3,1) both;">
            <div style="height:6px; background: linear-gradient(90deg, ${BRAND}, #ea580c 45%, #1E3A5F);"></div>
            <div style="display:flex; flex-direction:column; align-items:center; text-align:center;
              padding:50px 76px 56px;">
              ${logo}
              <div style="font:800 52px/1.2 'Segoe UI', system-ui, sans-serif; color:#0f172a;
                animation: mtmFadeUp .7s cubic-bezier(.16,1,.3,1) .1s both;">${title}</div>
              <div style="width:88px; height:4px; border-radius:2px; background:${BRAND}; margin-top:20px;
                transform-origin:center; animation: mtmUnderline .6s cubic-bezier(.16,1,.3,1) .4s both;"></div>
              ${subtitle ? `<div style="margin-top:18px; font:600 23px system-ui, sans-serif; color:#ea580c;
                animation: mtmFadeUpDelay .7s cubic-bezier(.16,1,.3,1) .35s both;">${subtitle}</div>` : ""}
              ${cta}
            </div>
