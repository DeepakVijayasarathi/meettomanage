          <div style="font:800 56px/1.18 'Segoe UI', system-ui, sans-serif; color:#fff;
            animation: mtmFadeUp .7s cubic-bezier(.16,1,.3,1) both;">${title}</div>
          <div style="width:96px; height:4px; border-radius:2px; background:${BRAND}; margin-top:20px;
