await (// Full continuous recording for the Meet to Manage demo video.
// - No marketing/landing-page footage: hook goes straight into the product.
// - Chapter beats use a custom animated overlay (fade-up text + slow Ken Burns
//   background pan) instead of the default showChapter template, for livelier motion.
// - Beat durations are paced from voiceover/manifest.json (actual TTS length); the
//   exact real screen-time per beat is measured via the returned beatLog and then
//   padded/trimmed frame-accurately in assemble.py — the waits below just need to be
//   in the right ballpark, not frame-perfect.
async page => {
  const BRAND = "#F97316";

  function callout(x, y, text) {
    return `
      <div style="position:absolute; top:${y}px; left:${x}px; padding:8px 16px;
        background:${BRAND}; border-radius:8px; font:600 15px system-ui, sans-serif; color:#fff;
        box-shadow:0 6px 18px rgba(0,0,0,0.35); white-space:nowrap;">
        ${text}
      </div>`;
  }

  function animatedCard(title, subtitle, opts = {}) {
    const logo = opts.logo
      ? `<img src="/logo-icon.png" style="width:64px;height:64px;object-fit:contain;margin-bottom:22px;animation: mtmFadeUp .6s cubic-bezier(.16,1,.3,1) both;" />`
      : "";
    return `
      <div style="position:absolute; inset:0; overflow:hidden;">
        <style>
          @keyframes mtmKenBurns {
            from { transform: scale(1.06) translate(-1.2%, -1%); }
            to   { transform: scale(1.16) translate(1.2%, 1%); }
          }
          @keyframes mtmFadeUp {
            from { opacity: 0; transform: translateY(26px); }
            to   { opacity: 1; transform: translateY(0); }
          }
          @keyframes mtmFadeUpDelay {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
          }
        </style>
        <div style="position:absolute; inset:-8%;
          background:
            radial-gradient(circle at 28% 22%, ${BRAND} 0%, transparent 42%),
            radial-gradient(circle at 76% 78%, #1E3A5F 0%, transparent 48%),
            linear-gradient(135deg, #0f172a, #1e293b);
          animation: mtmKenBurns 9s ease-in-out infinite alternate;"></div>
        <div style="position:absolute; inset:0;
          background: linear-gradient(180deg, rgba(15,23,42,0.55), rgba(15,23,42,0.85));"></div>
        <div style="position:absolute; inset:0; display:flex; flex-direction:column;
          align-items:center; justify-content:center; padding:0 140px; text-align:center;">
          ${logo}
          <div style="font:800 54px/1.18 'Segoe UI', system-ui, sans-serif; color:#fff;
            animation: mtmFadeUp .7s cubic-bezier(.16,1,.3,1) both;">${title}</div>
          ${subtitle ? `<div style="margin-top:20px; font:600 24px system-ui, sans-serif; color:${BRAND};
            animation: mtmFadeUpDelay .7s cubic-bezier(.16,1,.3,1) .18s both;">${subtitle}</div>` : ""}
        </div>
      </div>`;
  }

  await page.screencast.start({ path: "recordings/full-take.webm", size: { width: 1920, height: 1080 } });
  const t0 = Date.now();
  const beatLog = [];

  // ---- 01_hook (7.18s VO) — no product/landing page shown yet ----
  await page.goto("about:blank");
  await page.waitForTimeout(200);
  beatLog.push({ id: "01_hook", t: Date.now() - t0 });
  const hookCard = await page.screencast.showOverlay(
    animatedCard(
      "Running an academy shouldn't take five different tools.",
      "Scattered schedules. Manual attendance. Fees you have to chase."
    )
  );
  await page.waitForTimeout(7800);
  await hookCard.dispose();

  // ---- 03_login (6.19s VO) ----
  await page.goto("http://localhost:5173/login");
  await page.waitForTimeout(500);
  beatLog.push({ id: "03_login", t: Date.now() - t0 });
  const roleTrigger = page.getByRole("combobox", { name: "Preview as (demo)" });
  await roleTrigger.hover();
  await page.waitForTimeout(400);
  await roleTrigger.click();
  await page.waitForTimeout(900);
  await page.keyboard.press("Escape"); // close back onto Admin Portal without changing it
  await page.waitForTimeout(400);
  const signInBtn = page.getByRole("button", { name: /Sign in to Admin/i });
  await signInBtn.hover();
  await page.waitForTimeout(300);
  await signInBtn.click();
  await page.waitForTimeout(2200); // remaining pad to cover the 6.19s beat

  // ---- 04_dashboard (5.71s VO) ----
  await page.waitForTimeout(400);
  beatLog.push({ id: "04_dashboard", t: Date.now() - t0 });
  try {
    const attendanceCard = page.getByText("Attendance Rate").locator("..").locator("..");
    const bounds = await attendanceCard.boundingBox();
    if (bounds) {
      const cal = await page.screencast.showOverlay(
        callout(bounds.x, bounds.y - 40, "Real-time attendance")
      );
      await page.waitForTimeout(2200);
      await cal.dispose();
    }
  } catch {
    /* card not found — hold on the KPI row regardless */
  }
  await page.mouse.wheel(0, 380);
  await page.waitForTimeout(3700);

  // ---- 05_scheduling (5.98s VO) ----
  await page.goto("http://localhost:5173/admin/sessions");
  await page.waitForTimeout(500);
  beatLog.push({ id: "05_scheduling", t: Date.now() - t0 });
  try {
    const scheduleBtn = page.getByRole("button", { name: /Schedule Session/i });
    const bounds = await scheduleBtn.boundingBox();
    if (bounds) {
      const cal = await page.screencast.showOverlay(
        callout(bounds.x - 40, bounds.y - 40, "Schedule in one click")
      );
      await page.waitForTimeout(2400);
      await cal.dispose();
    }
  } catch {
    /* ignore */
  }
  await page.waitForTimeout(3500);

  // ---- 06_billing (6.43s VO) ----
  await page.goto("http://localhost:5173/admin/billing");
  await page.waitForTimeout(500);
  beatLog.push({ id: "06_billing", t: Date.now() - t0 });
  const allInvoicesTab = page.getByText("All Invoices", { exact: true });
  await allInvoicesTab.click();
  await page.waitForTimeout(900);
  try {
    const overduePill = page.getByText("Overdue").first();
    const bounds = await overduePill.boundingBox();
    if (bounds) {
      const cal = await page.screencast.showOverlay(
        callout(bounds.x, bounds.y - 40, "Overdue accounts flagged automatically")
      );
      await page.waitForTimeout(2400);
      await cal.dispose();
    }
  } catch {
    /* ignore */
  }
  await page.waitForTimeout(2900);

  // ---- 07_reports (5.69s VO) ----
  await page.goto("http://localhost:5173/admin/reports");
  await page.waitForTimeout(500);
  beatLog.push({ id: "07_reports", t: Date.now() - t0 });
  const generateBtn = page.getByRole("button", { name: "Generate" });
  await generateBtn.hover();
  await page.waitForTimeout(300);
  await generateBtn.click();
  await page.waitForTimeout(1200);
  try {
    const exportBtn = page.getByRole("button", { name: /Export CSV/i });
    const bounds = await exportBtn.boundingBox();
    if (bounds) {
      const cal = await page.screencast.showOverlay(
        callout(bounds.x - 160, bounds.y - 40, "Export as CSV")
      );
      await page.waitForTimeout(2300);
      await cal.dispose();
    }
  } catch {
    /* ignore */
  }
  await page.waitForTimeout(1500);

  // ---- 08_differentiator (5.69s VO) ----
  await page.waitForTimeout(300);
  beatLog.push({ id: "08_differentiator", t: Date.now() - t0 });
  const diffCard = await page.screencast.showOverlay(
    animatedCard("8 role-based portals. 1 system.", "Nothing stitched together after the fact.")
  );
  await page.waitForTimeout(6300);
  await diffCard.dispose();

  // ---- 09_cta (7.15s VO) ----
  await page.waitForTimeout(300);
  beatLog.push({ id: "09_cta", t: Date.now() - t0 });
  const ctaCard = await page.screencast.showOverlay(
    animatedCard("Meet to Manage", "Book your free demo at meettomanage.cloud", { logo: true })
  );
  await page.waitForTimeout(10300);
  await ctaCard.dispose();

  await page.screencast.stop();
  return beatLog;
}
)(page);
